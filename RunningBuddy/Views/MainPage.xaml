<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunningBuddy.Views.MainPage"
             BackgroundColor="#0F0F0F">

<!-- Main Page -->
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">
            
        <!-- The User Header -->
            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding UserName, StringFormat='Hello, {0}👋'}" FontSize="40" FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding LocationName}" TextColor="#888888" FontSize="16" />
            </VerticalStackLayout>


        <!-- Weather Card -->
            <Border StrokeShape="RoundRectangle 20" Padding="25" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A2E22" Offset="0.1" />
                        <GradientStop Color="#121212" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="Auto, *" ColumnSpacing="30" RowSpacing="10">
                    <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="15" VerticalOptions="Center">
                        <Image Source="{Binding WeatherIconUrl}" 
                               WidthRequest="64" 
                               HeightRequest="64" 
                               VerticalOptions="Center"/>
                        <VerticalStackLayout>
                            <Label Text="{Binding WeatherTemp}" FontSize="48" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="{Binding WeatherCondition}" TextColor="#AAAAAA"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <FlexLayout Grid.Row="0" Grid.Column="1" Wrap="Wrap" JustifyContent="SpaceEvenly" AlignItems="Center">
                        <VerticalStackLayout Margin="10">
                            <Label Text="💧 Humidity" FontSize="16" TextColor="#666666" Margin="0,0,0,5"/>
                            <Label Text="{Binding WeatherHumidity}" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="10">
                            <Label Text="💨 Wind" FontSize="16" TextColor="#666666" Margin="0,0,0,5"/>
                            <Label Text="{Binding WeatherWind}" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="10">
                            <Label Text="👁️ Visibility" FontSize="16" TextColor="#666666" Margin="0,0,0,5"/>
                            <Label Text="{Binding WeatherVisibility}" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </FlexLayout>

                    <!-- Change Location Button -->
                    <Button Grid.Row="1" Grid.ColumnSpan="2"
                            Text="📍 Change Location"
                            TextColor="#4CAF50"
                            BackgroundColor="Transparent"
                            FontSize="13"
                            HorizontalOptions="Start"
                            Clicked="OnChangeLocationClicked"/>
                </Grid>
            </Border>

        
        <!-- Recommended Clothing Card -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="15" >
                    <Label Text="👕 Recommended Clothing" TextColor="#BB86FC" FontAttributes="Bold" FontSize="20"/>
                    
                <!-- Head & Hands -->
                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Label Text="🧢" FontSize="20" Grid.Column="0" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Head &amp; Hands" FontSize="16" TextColor="#666666"/>
                                <Label Text="{Binding Hat}" TextColor="White" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                <!-- Top Layer -->
                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Label Text="👕" FontSize="20" Grid.Column="0" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Top Layer" FontSize="16" TextColor="#666666"/>
                                <Label Text="{Binding Top}" TextColor="White" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                <!-- Bottom Layer -->
                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Label Text="👖" FontSize="20" Grid.Column="0" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Bottoms" FontSize="16" TextColor="#666666"/>
                                <Label Text="{Binding Bottom}" TextColor="White" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                
                </VerticalStackLayout>

        <!-- Recommended Routes Card -->
                <VerticalStackLayout Grid.Column="1" Spacing="15">
                    <Label Text="📍 Recommended Routes" TextColor="#4CAF50" FontAttributes="Bold" FontSize="20"/>

                    <CollectionView ItemsSource="{Binding Routes}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" 
                                Padding="20" 
                                BackgroundColor="#1A1A1A" 
                                StrokeThickness="0">

                                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8">

                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Model.Name, StringFormat='{0}'}" FontSize="16" TextColor="White"/>
                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Model.Length, StringFormat='→ {0} miles'}" FontSize="12" TextColor="White"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Model.Elevation, StringFormat='⛰️ {0} ft'}" FontSize="12" TextColor="White"/>


                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>

            <!-- Schedule a Run Card -->
            <Border StrokeShape="RoundRectangle 20" Padding="25" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A1E2E" Offset="0.1" />
                        <GradientStop Color="#121212" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Spacing="15">
                    <Label Text="⏰ Schedule a Run" TextColor="#64B5F6" FontAttributes="Bold" FontSize="20"/>
                    <Label Text="Pick a date and time to see what to wear" TextColor="#888888" FontSize="13"/>

                    <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="15">
                        <!-- Date Picker -->
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label Text="Date" TextColor="#666666" FontSize="12"/>
                            <DatePicker Date="{Binding ScheduledRunDate, Mode=TwoWay}"
                                        MinimumDate="{Binding MinScheduledDate}"
                                        MaximumDate="{Binding MaxScheduledDate}"
                                        BackgroundColor="#1A1A1A"
                                        TextColor="White"/>
                        </VerticalStackLayout>

                        <!-- Time Picker -->
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label Text="Time" TextColor="#666666" FontSize="12"/>
                            <TimePicker Time="{Binding ScheduledRunTime, Mode=TwoWay}"
                                        BackgroundColor="#1A1A1A"
                                        TextColor="White"/>
                        </VerticalStackLayout>

                        <!-- Get Forecast Button -->
                        <Button Grid.Column="2" Text="Get Forecast"
                                BackgroundColor="#64B5F6" TextColor="Black"
                                CornerRadius="8" FontSize="13" FontAttributes="Bold"
                                VerticalOptions="End" HeightRequest="40" Padding="15,0"
                                Clicked="OnGetForecastClicked"/>
                    </Grid>

                    <!-- Loading Indicator -->
                    <ActivityIndicator IsRunning="{Binding IsLoadingForecast}" 
                                       IsVisible="{Binding IsLoadingForecast}"
                                       Color="#64B5F6"/>

                    <!-- Scheduled Forecast Results -->
                    <VerticalStackLayout IsVisible="{Binding HasScheduledForecast}" Spacing="10">
                        
                        <!-- Forecast Weather Info -->
                        <HorizontalStackLayout Spacing="10" Margin="0,5,0,0">
                            <Image Source="{Binding ScheduledWeatherIconUrl}" 
                                   WidthRequest="40" HeightRequest="40" VerticalOptions="Center"/>
                            <Label Text="{Binding ScheduledWeatherTemp}" FontSize="24" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                            <Label Text="{Binding ScheduledWeatherCondition}" TextColor="#AAAAAA" VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <BoxView HeightRequest="1" Color="#333333" Margin="0,5"/>

                        <!-- Scheduled Clothing Recommendation -->
                        <Label Text="Recommended for this time:" TextColor="#64B5F6" FontSize="14" FontAttributes="Bold"/>
                        
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                            <Border Grid.Column="0" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="#1A1A1A" StrokeThickness="0">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="🧢" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Head &amp; Hands" FontSize="11" TextColor="#666666" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding ScheduledHat}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="#1A1A1A" StrokeThickness="0">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="👕" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Top" FontSize="11" TextColor="#666666" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding ScheduledTop}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="2" StrokeShape="RoundRectangle 10" Padding="12" BackgroundColor="#1A1A1A" StrokeThickness="0">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="👖" FontSize="18" HorizontalOptions="Center"/>
                                    <Label Text="Bottoms" FontSize="11" TextColor="#666666" HorizontalTextAlignment="Center"/>
                                    <Label Text="{Binding ScheduledBottom}" TextColor="White" FontAttributes="Bold" FontSize="12" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

             <!-- Workout Planner Card -->
            <VerticalStackLayout Grid.Column="1" Spacing="15">
                    <Label Text="Todays Workout" TextColor="#fa6262" FontAttributes="Bold" FontSize="20"/>

                    <Border StrokeShape="RoundRectangle 12" Padding="20" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="5">
                                <Label Text="{Binding TodayWorkoutName}" TextColor="White" Grid.Row="0" Grid.Column="0" FontAttributes="Bold"/>
                                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Opacity="0.5">
                                    <Label Text="{Binding TodayWorkoutDistance}" FontSize="12" TextColor="White"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

