<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunningBuddy.Views.MainPage"
             BackgroundColor="#0F0F0F">

<!-- Main Page -->
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="25">
            
        <!-- The User Header -->
            <VerticalStackLayout Spacing="5">
                <Label Text="{Binding UserName, StringFormat='Hello, {0}👋'}" FontSize="40" FontAttributes="Bold" TextColor="White" />
                <!-- <Label Text="Tallahassee, FL · Today, 7:42 AM" TextColor="#888888" FontSize="16" /> -->
            </VerticalStackLayout>


        <!-- Weather Card -->
            <Border StrokeShape="RoundRectangle 20" Padding="25" StrokeThickness="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A2E22" Offset="0.1" />
                        <GradientStop Color="#121212" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="30">
                    <HorizontalStackLayout Grid.Column="0" Spacing="15" VerticalOptions="Center">
                        <Label Text="☁️" FontSize="50" VerticalOptions="Center"/>
                        <VerticalStackLayout>
                            <Label Text="65°F" FontSize="48" FontAttributes="Bold" TextColor="White"/>
                            <Label Text="Partly Cloudy" TextColor="#AAAAAA"/>
                        </VerticalStackLayout>
                    </HorizontalStackLayout>

                    <FlexLayout Grid.Column="1" Wrap="Wrap" JustifyContent="SpaceEvenly" AlignItems="Center">
                        <VerticalStackLayout Margin="10">
                            <Label Text="💧 Humidity" FontSize="16" TextColor="#666666" Margin="0,0,0,5"/>
                            <Label Text="52%" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="10">
                            <Label Text="💨 Wind" FontSize="16" TextColor="#666666" Margin="0,0,0,5"/>
                            <Label Text="7 MPH" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                        <VerticalStackLayout Margin="10">
                            <Label Text="👁️ Visibility" FontSize="16" TextColor="#666666" Margin="0,0,0,5"/>
                            <Label Text="10 mi" TextColor="White" FontAttributes="Bold"/>
                        </VerticalStackLayout>
                    </FlexLayout>
                </Grid>
            </Border>

        
        <!-- Recommended Clothing Card -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="20">
                <VerticalStackLayout Grid.Column="0" Spacing="15" >
                    <Label Text="👕 Recommended Clothing" TextColor="#BB86FC" FontAttributes="Bold" FontSize="20"/>
                    
                <!-- Head & Hands -->
                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Label Text="🧢" FontSize="20" Grid.Column="0" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Head &amp; Hands" FontSize="16" TextColor="#666666"/>
                                <Label Text="None needed" TextColor="White" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                <!-- Top Layer -->
                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Label Text="👕" FontSize="20" Grid.Column="0" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Top Layer" FontSize="16" TextColor="#666666"/>
                                <Label Text="Short-sleeve Shirt" TextColor="White" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                <!-- Bottom Layer -->
                    <Border StrokeShape="RoundRectangle 12" Padding="15" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="15">
                            <Label Text="👖" FontSize="20" Grid.Column="0" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="Bottoms" FontSize="16" TextColor="#666666"/>
                                <Label Text="Shorts or Pants" TextColor="White" FontAttributes="Bold"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                
                </VerticalStackLayout>

        <!-- Recommended Routes Card -->
                <VerticalStackLayout Grid.Column="1" Spacing="15">
                    <Label Text="📍 Recommended Routes" TextColor="#4CAF50" FontAttributes="Bold" FontSize="20"/>

                    <CollectionView ItemsSource="{Binding Routes}" SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 12" 
                                Padding="20" 
                                BackgroundColor="#1A1A1A" 
                                StrokeThickness="0">

                                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8">

                                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Model.Name, StringFormat='{0}'}" FontSize="16" TextColor="White"/>
                                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Model.Length, StringFormat='→ {0} miles'}" FontSize="12" TextColor="White"/>
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding Model.Elevation, StringFormat='⛰️ {0} ft'}" FontSize="12" TextColor="White"/>


                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Grid>

             <!-- Workout Planner Card -->
            <VerticalStackLayout Grid.Column="1" Spacing="15">
                    <Label Text="Todays Workout" TextColor="#fa6262" FontAttributes="Bold" FontSize="20"/>

                    <Border StrokeShape="RoundRectangle 12" Padding="20" BackgroundColor="#1A1A1A" StrokeThickness="0">
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="5">
                            <Label Text="Easy Run" TextColor="White" Grid.Row="0" Grid.Column="0" FontAttributes="Bold"/>
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Opacity="0.5">
                                <Label Text="4 miles" FontSize="12" TextColor="White"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
