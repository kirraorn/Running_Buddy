<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunningBuddy.Views.UserProfile"
             BackgroundColor="#0F0F0F"
             Title="UserProfile">

    

    <ScrollView>
        <Grid Padding="25" RowSpacing="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> <RowDefinition Height="Auto" /> </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                <Label Grid.Column="1" Text="{Binding UserName, StringFormat='{0}'}" FontSize="40" VerticalOptions="Center" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="Edit" Clicked ="EditClickedAsync" FontSize="12" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,5,0" />
                
            </Grid>

            <Grid Grid.Row="1" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Text="Weekly Summary" FontSize="18" FontAttributes="Bold" TextColor="LightBlue" />
                
                <Frame Grid.Row="1" BackgroundColor="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,10,0,0" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*, *, *">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Miles" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Text="15.2" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Runs" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Text="4" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="Time" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Text="2h 15m" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </Grid>

            <Grid Grid.Row="2" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Text="PR (Personal Records)" FontSize="18" FontAttributes="Bold" TextColor="LightGreen" />

                <CollectionView ItemsSource="{Binding PRs}" Grid.Row="1" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12" 
                    Padding="20" 
                    BackgroundColor="#1A1A1A" 
                    StrokeThickness="0"
                    Margin="0,5">

                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8">

                                    <Label Grid.Row="0" Grid.Column="0" 
                                    Text="{Binding Model.Distance, StringFormat='{0} Mile PR'}" 
                                    TextColor="White" 
                                    FontSize="18" 
                                    FontAttributes="Bold"/>

                                    <Label Grid.Row="0" Grid.Column="1" 
                                    Text="{Binding Model.BestTime, StringFormat='{0:mm}:{0:ss}'}" 
                                    TextColor="#4CAF50" 
                                    FontSize="18" 
                                    FontAttributes="Bold"
                                    HorizontalOptions="End"/>

                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10" Opacity="0.5">
                                        <Label Text="📅 Set on:" FontSize="12" TextColor="White"/>
                                        <Label Text="{Binding Model.DateRan, StringFormat='{0:MMM dd, yyyy}'}" 
                                        FontSize="12" 
                                        TextColor="White"/>
                                    </HorizontalStackLayout>

                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>

            <Grid Grid.Row="3" RowDefinitions="Auto, Auto, Auto">
                <Label Grid.Row="0" Text="Cold Sensitivity Score" FontSize="18" FontAttributes="Bold" TextColor="Orange" />
                
                <Slider Grid.Row="1" 
                        Minimum="1" 
                        Maximum="10" 
                        Value="5" 
                        MinimumTrackColor="LightBlue" 
                        MaximumTrackColor="DarkGray" 
                        ThumbColor="White"
                        Margin="0,15,0,5" />
                
                <Grid Grid.Row="2" ColumnDefinitions="*, *">
                    <Label Grid.Column="0" Text="1 (Loves Cold)" FontSize="12" TextColor="Gray" />
                    <Label Grid.Column="1" Text="10 (Hates Cold)" FontSize="12" TextColor="Gray" HorizontalOptions="End" />
                </Grid>
            </Grid>
            
        </Grid>
    </ScrollView>
</ContentPage>