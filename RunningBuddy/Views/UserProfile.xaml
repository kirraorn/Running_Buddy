<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunningBuddy.Views.UserProfile"
             xmlns:models="clr-namespace:RunningBuddy.Models"
             BackgroundColor="#0F0F0F"
             Title="UserProfile">

    

    <ScrollView>
    
        <Grid Padding="25" RowSpacing="25">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Name and Edit Button -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
                <Label Grid.Column="1" 
                FontSize="40" 
                VerticalOptions="Center" 
                FontAttributes="Bold" 
                TextColor="White">
                    <Label.Text>
                        <MultiBinding StringFormat="{}{0}: {1} Total Mi">
                            <Binding Path="UserName" />
                            <Binding Path="TotalMiles" />
                        </MultiBinding>
                    </Label.Text>
                </Label>
                <Button Grid.Column="3" FontFamily="FontAwsome7" Text="{x:Static models:FontAwsome7.PenToSquare}"  Clicked ="EditClickedAsync"  HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,5,0" />
                
            </Grid>
            


            <Grid Grid.Row="1" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Text="Weekly Summary" FontSize="18" FontAttributes="Bold" TextColor="LightBlue" />
                
                <Frame Grid.Row="1" BackgroundColor="#1A1A1A" CornerRadius="8" Padding="15" Margin="0,10,0,0" BorderColor="Transparent">
                    <Grid ColumnDefinitions="*, *, *">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                            <Label Text="Miles" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Text="15.2" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                            <Label Text="Runs" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Text="4" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center">
                            <Label Text="Time" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label Text="2h 15m" FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Frame>
            </Grid>

            <!-- Active Training Plan -->
            <Grid Grid.Row="2" RowDefinitions="Auto, Auto">
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <Label Grid.Column="0" 
                           Text="🏃 Training Plan" 
                           FontSize="18" 
                           FontAttributes="Bold" 
                           TextColor="#A3E635" 
                           VerticalOptions="Center" />
                    
                    <Button Grid.Column="1" 
                            Text="+ New Plan" 
                            Clicked="NewPlanClicked" 
                            BackgroundColor="Transparent"
                            TextColor="#A3E635"
                            FontSize="14"
                            Padding="10,0"/>
                </Grid>

                <Border Grid.Row="1" StrokeShape="RoundRectangle 12" 
                        Padding="20" BackgroundColor="#1A1A1A" StrokeThickness="0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding ActivePlanName}" 
                               TextColor="White" FontSize="16" FontAttributes="Bold"/>
                        <Label Text="{Binding ActivePlanProgress}" 
                               TextColor="#888888" FontSize="13"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Grid Grid.Row="3" RowDefinitions="Auto, Auto">
    
    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
        <Label Grid.Column="0" 
               Text="PR (Personal Records)" 
               FontSize="18" 
               FontAttributes="Bold" 
               TextColor="LightGreen" 
               VerticalOptions="Center" />
        
        <Button Grid.Column="1" 
                FontFamily="FontAwsome7" 
                Text="{x:Static models:FontAwsome7.Plus}" 
                Clicked="AddPRClickedAsync" 
                BackgroundColor="Transparent"
                TextColor="LightGreen"
                FontSize="20"
                Padding="10,0"/>
    </Grid>

    <CollectionView Grid.Row="1" ItemsSource="{Binding PRs}" SelectionMode="None">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
        </CollectionView.ItemsLayout>

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border StrokeShape="RoundRectangle 12" 
                        Padding="20" 
                        BackgroundColor="#1A1A1A" 
                        StrokeThickness="0"
                        Margin="0,5">

                    <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.RowSpan="2">
                            <Label Text="{Binding Model.Distance, StringFormat='{0} Mile PR'}" 
                                   TextColor="White" 
                                   FontSize="18" 
                                   FontAttributes="Bold"/>
                            
                            <HorizontalStackLayout Spacing="10" Opacity="0.5" Margin="0,5,0,0">
                                <Label Text="📅 Set on:" FontSize="12" TextColor="White"/>
                                <Label Text="{Binding Model.DateRan, StringFormat='{0:MMM dd, yyyy}'}" 
                                       FontSize="12" 
                                       TextColor="White"/>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" HorizontalOptions="End">
                            <Label Text="{Binding Model.BestTime, StringFormat='{0:mm}:{0:ss}'}" 
                                   TextColor="#4CAF50" 
                                   FontSize="18" 
                                   FontAttributes="Bold"
                                   HorizontalOptions="End"/>

                            <HorizontalStackLayout Spacing="5" HorizontalOptions="End" Margin="0,8,0,0">
                                <Button FontFamily="FontAwsome7" 
                                        Text="{x:Static models:FontAwsome7.Pen}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.EditPRCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" 
                                        TextColor="Gray" 
                                        FontSize="14"
                                        HeightRequest="35"
                                        WidthRequest="35"/>
                                
                                <Button FontFamily="FontAwsome7" 
                                        Text="{x:Static models:FontAwsome7.Trash}" 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeletePRCommand}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Transparent" 
                                        TextColor="#FF5252" 
                                        FontSize="14"
                                        HeightRequest="35"
                                        WidthRequest="35"/>
                            </HorizontalStackLayout>
                             </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
         </Grid>


            <!-- Cold Sensitivity Score -->
            <Grid Grid.Row="4" RowDefinitions="Auto, Auto, Auto">
                <Label Grid.Row="0" Text="Cold Sensitivity Score" FontSize="18" FontAttributes="Bold" TextColor="Orange" />
                
                <Slider Grid.Row="1" 
                        Minimum="1" 
                        Maximum="5" 
                        Value="{Binding ColdPref}" 
                        MinimumTrackColor="LightBlue" 
                        MaximumTrackColor="DarkGray" 
                        ThumbColor="White"
                        Margin="0,15,0,5" 
                        />
                
                <Grid Grid.Row="2" ColumnDefinitions="*, *">
                    <Label Grid.Column="0" Text="1 (Low Cold Tolerance)" FontSize="12" TextColor="Gray" />
                    <Label Grid.Column="1" Text="5 (High Cold Tolerance)" FontSize="12" TextColor="Gray" HorizontalOptions="End" />
                </Grid>
            </Grid>

            <!-- Performance History -->
            <Grid Grid.Row="5" RowDefinitions="Auto, Auto">
                <Label Grid.Row="0" Text="Workout History" FontSize="18" FontAttributes="Bold" TextColor="#FF9290EE" />

                <CollectionView Grid.Row="1" ItemsSource="{Binding WeeklyWorkouts}" SelectionMode="None" Margin="0,8,0,0">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 12"
                                    Padding="20"
                                    BackgroundColor="#1A1A1A"
                                    StrokeThickness="0"
                                    Margin="0,5">

                                <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="8">
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding RouteName}"
                                           TextColor="White"
                                           FontSize="18"
                                           FontAttributes="Bold" />

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Distance, StringFormat='{0:F1} mi'}"
                                           TextColor="#4CAF50"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End" />

                                    <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Spacing="10" Opacity="0.6">
                                        <Label Text="Date:" FontSize="12" TextColor="White" />
                                        <Label Text="{Binding Model.Date, StringFormat='{0:MMM dd, yyyy}'}"
                                               FontSize="12"
                                               TextColor="White" />
                                        <Label Text="Elevation:" FontSize="12" TextColor="White" Margin="12,0,0,0" />
                                        <Label Text="{Binding Model.Elevation, StringFormat='{0} ft'}"
                                               FontSize="12"
                                               TextColor="White" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            
        </Grid>
    </ScrollView>
</ContentPage>
