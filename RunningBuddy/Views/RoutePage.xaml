<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RunningBuddy.Views.RoutePage"
             BackgroundColor="#0F0F0F">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <!-- Title -->
                    <Label Text="Routes" FontSize="40" FontAttributes="Bold" TextColor="White"/>
                    <Label Text="Save and manage your custom running routes" TextColor="#888888" FontSize="14"/>
                </VerticalStackLayout>
                
                <!-- Create Route Button -->
                <Button Grid.Column="1" Text="+ Create Route" 
                        BackgroundColor="#A3E635" TextColor="Black" 
                        CornerRadius="8" Padding="15,0" HeightRequest="40"
                        Clicked="AddorEditRoutesClicked"/>
            </Grid>

<!-- Stats Grid -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15" HeightRequest="100">
                <Border Grid.Column="0" StrokeShape="RoundRectangle 12" BackgroundColor="#1A1A1A" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="7" TextColor="#4CAF50" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Total Routes" TextColor="#666666" FontSize="12" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="1" StrokeShape="RoundRectangle 12" BackgroundColor="#1A1A1A" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="37" TextColor="#4CAF50" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Total Miles" TextColor="#666666" FontSize="12" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Column="2" StrokeShape="RoundRectangle 12" BackgroundColor="#1A1A1A" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="5">
                        <Label Text="3" TextColor="#4CAF50" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                        <Label Text="Favorites" TextColor="#666666" FontSize="12" HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Grid>

<!-- Favorites Label -->
            <Label Text="⭐ Favorites" TextColor="#FACC15" FontAttributes="Bold" Margin="0,10,0,0" FontSize="20"/>
            
            <CollectionView ItemsSource="{Binding Routes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" BackgroundColor="#1A1A1A" BorderColor="#333333" CornerRadius="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="10">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                        <Border BackgroundColor="#333333" Padding="8,2" StrokeShape="RoundRectangle 4">
                                            <Label Text="{Binding Terrain}" TextColor="Gray" FontSize="12"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    
                                    <HorizontalStackLayout Spacing="15">
                                        <Label Text="{Binding Length, StringFormat='{0} mi'}" TextColor="Gray"/>
                                        <Label Text="{Binding Elevation, StringFormat='{0} ft gain'}" TextColor="Gray"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

<!-- All Routes -->
            <Label Text="All Routes" TextColor="#FACC15" FontAttributes="Bold" Margin="0,10,0,0" FontSize="20"/>
            
            <CollectionView ItemsSource="{Binding Routes}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,5" Padding="15" BackgroundColor="#1A1A1A" BorderColor="#333333" CornerRadius="12">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Spacing="10">
                                    <HorizontalStackLayout Spacing="10">
                                        <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="White"/>
                                        <Border BackgroundColor="#333333" Padding="8,2" StrokeShape="RoundRectangle 4">
                                            <Label Text="{Binding Terrain}" TextColor="Gray" FontSize="12"/>
                                        </Border>
                                    </HorizontalStackLayout>
                                    
                                    <HorizontalStackLayout Spacing="15">
                                        <Label Text="{Binding Length, StringFormat='{0} mi'}" TextColor="Gray"/>
                                        <Label Text="{Binding Elevation, StringFormat='{0} ft gain'}" TextColor="Gray"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>